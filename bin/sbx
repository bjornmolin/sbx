#!/usr/bin/env bash
# sbx — run CLI tools (Claude Code, OpenCode, cargo, npm, ...) inside an
# egress-filtered rootless containerd sandbox. One container runtime, many
# projects in parallel.
#
# - macOS: a single shared Lima VM ('sbx') with $HOME mounted hosts containerd.
#   Created lazily, never restarted to add projects.
# - Linux: rootless containerd on the host; no VM layer.
#
# Per project: its own --internal nerdctl network, its own proxy container
# (with the project's allowlist bind-mounted in), and its own /home/dev cache
# volume. All projects share one proxy image and one sandbox image.

set -euo pipefail

# ---------------------------------------------------------------------------
# Paths, platform, identity
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

case "$(uname)" in
  Darwin) PLATFORM=darwin ;;
  Linux)  PLATFORM=linux  ;;
  *) printf '[sbx] unsupported platform: %s\n' "$(uname)" >&2; exit 1 ;;
esac

SBX_LIMA="${SBX_LIMA:-sbx}"           # shared Lima VM name (macOS only)
NET_EXTERNAL="sbx-external"           # shared bridge; every proxy uses it
SANDBOX_IMAGE="sbx-sandbox:latest"
PROXY_IMAGE="sbx-proxy:latest"

HOST_UID="$(id -u)"
HOST_GID="$(id -g)"

REGISTRY="${SBX_REGISTRY:-$HOME/.config/sbx/projects.json}"
CONFIG="${SBX_CONFIG:-$HOME/.config/sbx/config.json}"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
log() { printf '\033[1;36m[sbx]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[sbx]\033[0m %s\n' "$*" >&2; exit 1; }

command -v jq >/dev/null \
  || die "jq is required. brew install jq  (macOS) / apt install jq (linux)"

# Dispatch nerdctl to Lima or to the host depending on platform.
nerdctl() {
  case "$PLATFORM" in
    darwin) limactl shell "$SBX_LIMA" -- nerdctl "$@" ;;
    linux)  command nerdctl "$@" ;;
  esac
}

# ---------------------------------------------------------------------------
# Runtime: Lima VM on macOS, rootless containerd on Linux.
# ---------------------------------------------------------------------------
lima_running() {
  [[ "$(limactl list --format '{{.Status}}' "$SBX_LIMA" 2>/dev/null || true)" == "Running" ]]
}

# Render the YAML 'mounts:' block from the config. Each existing dir on the
# host becomes a writable mount; non-existent paths are skipped so Lima
# doesn't refuse to start.
render_lima_mounts_to() {
  local out="$1"
  local md expanded any=0
  : > "$out"
  while IFS= read -r md; do
    expanded="$(expand_tilde "$md")"
    if [[ -d "$expanded" ]]; then
      printf -- '- location: "%s"\n  writable: true\n' "$expanded" >> "$out"
      any=1
    fi
  done < <(config_mount_dirs)
  (( any )) || die "no configured mount_dirs exist on disk.
  Edit $CONFIG, or run: bin/sbx add-mount <dir>"
}

# Build a Lima yaml by concatenating the base template with the rendered
# 'mounts:' block. The base template intentionally omits 'mounts:'.
build_lima_yaml_to() {
  local out="$1"
  local mounts_tmp; mounts_tmp="$(mktemp)"
  render_lima_mounts_to "$mounts_tmp"
  cp "$ROOT/lima/sandbox.yaml" "$out"
  {
    printf '\nmounts:\n'
    cat "$mounts_tmp"
  } >> "$out"
  rm -f "$mounts_tmp"
}

# Splice the 'mounts:' block of an existing Lima instance config in place.
# Used when add-mount is run against an already-created VM (requires
# limactl stop+start to take effect — that's the caller's responsibility).
splice_lima_mounts() {
  local file="$1"
  local mounts_tmp; mounts_tmp="$(mktemp)"
  render_lima_mounts_to "$mounts_tmp"
  local tmp; tmp="$(mktemp)"
  awk -v mfile="$mounts_tmp" '
    /^mounts:/ {
      print "mounts:"
      while ((getline line < mfile) > 0) print line
      close(mfile)
      in_mounts = 1
      next
    }
    in_mounts {
      # The mounts block ends at the next non-indented, non-dash line.
      if ($0 ~ /^[A-Za-z]/) { in_mounts = 0; print; next }
      next
    }
    { print }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
  rm -f "$mounts_tmp"
}

ensure_runtime() {
  case "$PLATFORM" in
    darwin)
      if ! limactl list -q 2>/dev/null | grep -qx "$SBX_LIMA"; then
        log "creating shared Lima VM '$SBX_LIMA' (one-time)"
        local tmp; tmp="$(mktemp -t sbx-lima.XXXXXX)"
        build_lima_yaml_to "$tmp"
        limactl create --name "$SBX_LIMA" "$tmp"
        rm -f "$tmp"
      fi
      if ! lima_running; then
        log "starting Lima VM '$SBX_LIMA'"
        limactl start "$SBX_LIMA"
      fi
      ;;
    linux)
      command -v nerdctl >/dev/null \
        || die "nerdctl not on PATH. install rootless containerd + nerdctl first."
      if ! nerdctl version >/dev/null 2>&1; then
        die "nerdctl cannot reach a containerd. set up rootless containerd:
  containerd-rootless-setuptool.sh install"
      fi
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Registry (~/.config/sbx/projects.json): { "<id>": "<absolute path>", ... }
# ---------------------------------------------------------------------------
ensure_registry() {
  mkdir -p "$(dirname "$REGISTRY")"
  [[ -f "$REGISTRY" ]] || printf '{}\n' > "$REGISTRY"
}

registry_get()   { ensure_registry; jq -r --arg k "$1" '.[$k] // ""' "$REGISTRY"; }
registry_set()   {
  ensure_registry
  local tmp; tmp="$(mktemp)"
  jq --arg k "$1" --arg v "$2" '.[$k] = $v' "$REGISTRY" > "$tmp" && mv "$tmp" "$REGISTRY"
}
registry_delete() {
  ensure_registry
  local tmp; tmp="$(mktemp)"
  jq --arg k "$1" 'del(.[$k])' "$REGISTRY" > "$tmp" && mv "$tmp" "$REGISTRY"
}
registry_list_pairs() {
  ensure_registry
  jq -r 'to_entries[] | "\(.key)\t\(.value)"' "$REGISTRY"
}

# ---------------------------------------------------------------------------
# Config (~/.config/sbx/config.json)
#
# Holds the list of host directories Lima is allowed to mount into the VM.
# Default: ["~/dev"]. The narrower this list, the less the Lima VM can see
# of $HOME if anything ever pivots through the container into the VM —
# dotfiles like ~/.ssh, ~/.aws, ~/.gnupg stay invisible.
# Linux skips this entirely (no VM, no mount layer to scope).
# ---------------------------------------------------------------------------
ensure_config() {
  mkdir -p "$(dirname "$CONFIG")"
  [[ -f "$CONFIG" ]] || printf '{\n  "mount_dirs": ["~/dev"]\n}\n' > "$CONFIG"
}

config_mount_dirs() {
  ensure_config
  jq -r '.mount_dirs[]' "$CONFIG"
}

# Add a directory to the mount list (does not apply to the live VM —
# cmd_add_mount handles that and asks before restarting Lima).
config_add_mount_dir() {
  ensure_config
  local tmp; tmp="$(mktemp)"
  jq --arg d "$1" '.mount_dirs |= (. + [$d] | unique)' "$CONFIG" > "$tmp"
  mv "$tmp" "$CONFIG"
}

# Expand a leading ~ to $HOME so the rest of the wrapper can treat the
# result as an absolute path. Avoid `${1#~/}` because bash tilde-expands
# the pattern itself before matching, defeating the strip.
expand_tilde() {
  case "$1" in
    "~")    printf '%s' "$HOME" ;;
    "~/"*)  printf '%s/%s' "$HOME" "${1:2}" ;;
    *)      printf '%s' "$1" ;;
  esac
}

# Echo the configured mount dir whose expansion contains $1 — empty if none.
mount_dir_containing() {
  local target="$1" md expanded
  while IFS= read -r md; do
    expanded="$(expand_tilde "$md")"
    case "$target" in
      "$expanded"|"$expanded"/*) printf '%s' "$md"; return 0 ;;
    esac
  done < <(config_mount_dirs)
  return 0
}

# ---------------------------------------------------------------------------
# Project identity & discovery
# ---------------------------------------------------------------------------
project_id_for() {
  local p="$1"
  local base; base="$(basename "$p" | LC_ALL=C tr -c 'A-Za-z0-9' '-' | tr 'A-Z' 'a-z')"
  base="${base#-}"; base="${base%-}"; base="${base:-proj}"; base="${base:0:20}"
  local hash; hash="$(printf '%s' "$p" | shasum -a 256 | cut -c1-8)"
  printf '%s-%s' "$base" "$hash"
}
project_dir_for()   { registry_get "$1"; }
list_project_ids()  { registry_list_pairs | awk -F '\t' 'NF { print $1 }'; }

# Longest-prefix match: the project whose registered dir contains $1.
discover_project() {
  local cwd="$1" best="" best_len=0
  local id mount
  while IFS=$'\t' read -r id mount; do
    [[ -z "$id" ]] && continue
    case "$cwd" in
      "$mount"|"$mount"/*)
        if (( ${#mount} > best_len )); then best="$id"; best_len=${#mount}; fi
        ;;
    esac
  done < <(registry_list_pairs)
  printf '%s' "$best"
  return 0
}

# Per-project containerd object names.
int_net_for()  { printf 'sbx-int-%s' "$1"; }
proxy_for()    { printf 'sbx-proxy-%s' "$1"; }
home_vol_for() { printf 'sbx-home-%s' "$1"; }

# ---------------------------------------------------------------------------
# Shared images
# ---------------------------------------------------------------------------
image_exists() {
  nerdctl images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -qx "$1"
}

build_proxy_image() {
  log "building proxy image"
  nerdctl build -t "$PROXY_IMAGE" "$ROOT/proxy"
}

build_sandbox_image() {
  log "building sandbox image (slow the first time)"
  nerdctl build \
    --build-arg "USER_UID=${HOST_UID}" \
    --build-arg "USER_GID=${HOST_GID}" \
    -t "$SANDBOX_IMAGE" "$ROOT/sandbox"
}

ensure_external_network() {
  if ! nerdctl network ls --format '{{.Name}}' 2>/dev/null | grep -qx "$NET_EXTERNAL"; then
    log "creating shared external network $NET_EXTERNAL"
    nerdctl network create "$NET_EXTERNAL" >/dev/null
  fi
}

ensure_images() {
  ensure_external_network
  image_exists "$PROXY_IMAGE"   || build_proxy_image
  image_exists "$SANDBOX_IMAGE" || build_sandbox_image
}

# ---------------------------------------------------------------------------
# Per-project proxy lifecycle
# ---------------------------------------------------------------------------
proxy_running_for() {
  nerdctl ps --format '{{.Names}}' 2>/dev/null | grep -qx "$(proxy_for "$1")"
}

ensure_project_proxy() {
  local pid="$1" pdir="$2"
  local int proxy
  int="$(int_net_for "$pid")"
  proxy="$(proxy_for "$pid")"

  if ! nerdctl network ls --format '{{.Name}}' 2>/dev/null | grep -qx "$int"; then
    log "creating internal network $int"
    nerdctl network create --internal "$int" >/dev/null
  fi

  if proxy_running_for "$pid"; then return 0; fi
  if nerdctl ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$proxy"; then
    nerdctl rm -f "$proxy" >/dev/null
  fi

  log "starting proxy $proxy"
  local mounts=( -v "$ROOT/allowlist.conf:/etc/sbx/allowlist.conf:ro" )
  if [[ -f "$pdir/.sbx/allowlist.local.conf" ]]; then
    mounts+=( -v "$pdir/.sbx/allowlist.local.conf:/etc/sbx/allowlist.local.conf:ro" )
    log "including $pdir/.sbx/allowlist.local.conf"
  fi
  nerdctl run -d \
    --name "$proxy" \
    --network "$int" \
    --network "$NET_EXTERNAL" \
    --dns 1.1.1.1 --dns 9.9.9.9 \
    "${mounts[@]}" \
    "$PROXY_IMAGE" >/dev/null
}

# nerdctl renames multi-attached networks to "unknown-ethN" in inspect, so we
# discover the proxy's internal IP by matching against the internal network's
# subnet prefix from `network inspect`.
proxy_ip_for() {
  local pid="$1"
  local int; int="$(int_net_for "$pid")"
  local subnet
  subnet="$(nerdctl network inspect "$int" \
    --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}' 2>/dev/null || true)"
  [[ -n "$subnet" ]] || return 1
  local prefix="${subnet%/*}"
  prefix="${prefix%.*}."
  nerdctl container inspect "$(proxy_for "$pid")" 2>/dev/null \
    | grep -oE '"IPAddress": "'"${prefix//./\\.}"'[0-9]+"' \
    | head -1 \
    | sed -E 's/.*"([0-9.]+)".*/\1/'
}

teardown_project() {
  local pid="$1"
  local proxy int vol
  proxy="$(proxy_for "$pid")"; int="$(int_net_for "$pid")"; vol="$(home_vol_for "$pid")"
  if nerdctl ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$proxy"; then
    log "removing proxy $proxy"
    nerdctl rm -f "$proxy" >/dev/null 2>&1 || true
  fi
  if nerdctl network ls --format '{{.Name}}' 2>/dev/null | grep -qx "$int"; then
    log "removing network $int"
    nerdctl network rm "$int" >/dev/null 2>&1 || true
  fi
  if nerdctl volume ls --format '{{.Name}}' 2>/dev/null | grep -qx "$vol"; then
    log "removing volume $vol"
    nerdctl volume rm "$vol" >/dev/null 2>&1 || true
  fi
  registry_delete "$pid"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_setup() {
  local pdir="$PWD"
  local pid; pid="$(project_id_for "$pdir")"

  local existing; existing="$(discover_project "$pdir")"
  if [[ -n "$existing" && "$existing" != "$pid" ]]; then
    local er; er="$(project_dir_for "$existing")"
    die "this directory is already inside another sbx project:
  parent: $er  (id: $existing)
  Work inside that one, or move this dir to register it separately."
  fi

  # macOS only: refuse to register a project that Lima can't see. Linux
  # has no Lima layer and no mount scoping; setup accepts any path.
  if [[ "$PLATFORM" == "darwin" ]]; then
    local md; md="$(mount_dir_containing "$pdir")"
    if [[ -z "$md" ]]; then
      die "this dir is not under any configured Lima mount:
  $pdir
  Currently mounted: $(config_mount_dirs | paste -sd ' ' -)
  Either move the project under one of those dirs, or add a new mount with:
      bin/sbx add-mount <parent-dir>
  (adding a mount restarts the shared Lima VM)"
    fi
  fi

  ensure_runtime
  ensure_images
  registry_set "$pid" "$pdir"
  ensure_project_proxy "$pid" "$pdir"
  log "setup complete. project: $pdir  id: $pid"
}

cmd_mounts() {
  ensure_config
  if [[ "$PLATFORM" == "linux" ]]; then
    echo "(Linux: mount_dirs is unused — no Lima layer to scope.)"
  fi
  config_mount_dirs
}

cmd_add_mount() {
  local dir="${1:-}"
  [[ -n "$dir" ]] || die "usage: bin/sbx add-mount <dir>"
  dir="$(expand_tilde "$dir")"
  [[ -d "$dir" ]] || die "not a directory: $dir"
  dir="$(cd "$dir" && pwd)"
  if [[ "$PLATFORM" == "linux" ]]; then
    config_add_mount_dir "$dir"
    log "added $dir to mount_dirs (note: Linux ignores this list)."
    return 0
  fi

  if [[ -n "$(mount_dir_containing "$dir")" ]]; then
    log "$dir is already covered by an existing mount; nothing to do."
    return 0
  fi

  config_add_mount_dir "$dir"
  log "added $dir to mount_dirs."

  if ! limactl list -q 2>/dev/null | grep -qx "$SBX_LIMA"; then
    log "(Lima VM not yet created — mount takes effect on first 'bin/sbx setup'.)"
    return 0
  fi

  log "applying to the running Lima VM. This will RESTART the VM and"
  log "interrupt every running project's proxy/sandbox container."
  if [[ -t 0 ]]; then
    read -r -p "[sbx] continue? [y/N] " yn
    [[ "$yn" =~ ^[Yy]$ ]] || die "cancelled."
  fi

  splice_lima_mounts "$HOME/.lima/$SBX_LIMA/lima.yaml"
  log "stopping Lima VM"
  limactl stop "$SBX_LIMA" >/dev/null 2>&1 || true
  log "starting Lima VM"
  limactl start "$SBX_LIMA" >/dev/null 2>&1
  log "mount applied. Re-run 'bin/sbx up' from each project you want back online."
}

cmd_reset() {
  if [[ "${1:-}" == "--all" ]]; then
    local count=0
    local ids=() id
    # Materialise the list before the loop: limactl shell inside the body
    # would otherwise consume the process-substitution stdin and cut the
    # loop short after one iteration.
    while IFS= read -r id; do ids+=("$id"); done < <(list_project_ids)
    for id in "${ids[@]+"${ids[@]}"}"; do
      [[ -z "$id" ]] && continue
      teardown_project "$id"
      count=$((count + 1))
    done
    log "reset complete. $count project(s) removed."
    [[ "$PLATFORM" == "darwin" ]] && \
      log "shared Lima VM left running (use 'limactl delete $SBX_LIMA' to remove it)."
    return
  fi
  local pid; pid="$(discover_project "$PWD")"
  if [[ -z "$pid" ]]; then
    log "no sbx project owns this directory ($PWD). nothing to reset."
    return
  fi
  teardown_project "$pid"
}

cmd_prune() {
  local removed=0
  local pairs=() line
  while IFS= read -r line; do pairs+=("$line"); done < <(registry_list_pairs)
  for line in "${pairs[@]+"${pairs[@]}"}"; do
    local pid path
    IFS=$'\t' read -r pid path <<< "$line"
    [[ -z "$pid" ]] && continue
    local proxy; proxy="$(proxy_for "$pid")"
    if ! nerdctl ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$proxy"; then
      log "pruning stale entry: $pid -> $path"
      registry_delete "$pid"
      removed=$((removed + 1))
    fi
  done
  log "prune done. $removed stale entr$([[ $removed == 1 ]] && echo y || echo ies) removed."
}

cmd_build() {
  ensure_runtime
  ensure_external_network
  build_proxy_image
  build_sandbox_image
}

cmd_build_proxy() {
  ensure_runtime
  ensure_external_network
  build_proxy_image
  # Restart every project's proxy so they pick up the rebuilt image.
  local ids=() id
  while IFS= read -r id; do ids+=("$id"); done < <(list_project_ids)
  for id in "${ids[@]+"${ids[@]}"}"; do
    [[ -z "$id" ]] && continue
    if nerdctl ps -a --format '{{.Names}}' | grep -qx "$(proxy_for "$id")"; then
      log "restarting proxy for $id"
      nerdctl rm -f "$(proxy_for "$id")" >/dev/null 2>&1 || true
      ensure_project_proxy "$id" "$(project_dir_for "$id")"
    fi
  done
}

cmd_up() {
  local pid; pid="$(discover_project "$PWD")"
  [[ -n "$pid" ]] || die "no project owns this directory; run 'bin/sbx setup' here first."
  ensure_runtime
  ensure_project_proxy "$pid" "$(project_dir_for "$pid")"
}

cmd_down() {
  local pid; pid="$(discover_project "$PWD")"
  [[ -n "$pid" ]] || die "no project owns this directory."
  local proxy; proxy="$(proxy_for "$pid")"
  if nerdctl ps -a --format '{{.Names}}' | grep -qx "$proxy"; then
    nerdctl rm -f "$proxy" >/dev/null
    log "proxy $proxy stopped."
  fi
}

cmd_logs() {
  local pid; pid="$(discover_project "$PWD")"
  [[ -n "$pid" ]] || die "no project owns this directory."
  nerdctl logs -f "$(proxy_for "$pid")"
}

cmd_run() {
  local cwd_in="" interactive=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir)    cwd_in="$2"; shift 2 ;;
      --no-tty) interactive=0; shift ;;
      --)       shift; break ;;
      -h|--help) usage; exit 0 ;;
      *)        break ;;
    esac
  done
  [[ $# -gt 0 ]] || die "nothing to run. example:  sbx run -- cargo build"

  local cwd_host
  cwd_host="$(cd "${cwd_in:-$PWD}" 2>/dev/null && pwd)" \
    || die "no such directory: ${cwd_in:-$PWD}"

  local pid; pid="$(discover_project "$cwd_host")"
  [[ -n "$pid" ]] || die "no sbx project owns this directory:
  $cwd_host
  cd into a registered project, or run 'bin/sbx setup' here."

  local pdir; pdir="$(project_dir_for "$pid")"
  local rel="${cwd_host#"$pdir"}"; rel="${rel#/}"
  local container_wd="/work${rel:+/$rel}"

  ensure_runtime
  ensure_project_proxy "$pid" "$pdir"

  local proxy_ip; proxy_ip="$(proxy_ip_for "$pid")"
  [[ -n "$proxy_ip" ]] || die "could not discover proxy IP for $pid"

  local tty_flags=()
  if (( interactive )) && [[ -t 0 && -t 1 ]]; then tty_flags=(-it); fi

  nerdctl run --rm "${tty_flags[@]}" \
    --network "$(int_net_for "$pid")" \
    --dns "$proxy_ip" \
    --user "${HOST_UID}:${HOST_GID}" \
    -v "${pdir}:/work" \
    -v "$(home_vol_for "$pid"):/home/dev" \
    -w "$container_wd" \
    -e HOME=/home/dev \
    -e TERM="${TERM:-xterm-256color}" \
    "$SANDBOX_IMAGE" "$@"
}

cmd_shell() { cmd_run "$@" -- fish --login; }

cmd_status() {
  if [[ "${1:-}" == "--all" ]]; then
    local found=0
    local pairs=() line
    while IFS= read -r line; do pairs+=("$line"); done < <(registry_list_pairs)
    for line in "${pairs[@]+"${pairs[@]}"}"; do
      local pid path s="stopped"
      IFS=$'\t' read -r pid path <<< "$line"
      [[ -z "$pid" ]] && continue
      found=1
      if proxy_running_for "$pid"; then s="running"; fi
      printf '%-32s  %-8s  %s\n' "$pid" "$s" "$path"
    done
    (( found )) || echo "no sbx projects registered."
    return 0
  fi

  local pid; pid="$(discover_project "$PWD")"
  if [[ -z "$pid" ]]; then
    echo "no sbx project owns this directory ($PWD)."
    echo "registered projects:  bin/sbx status --all"
    return 0
  fi
  echo "Project:    $(project_dir_for "$pid")"
  echo "ID:         $pid"
  echo "Platform:   $PLATFORM"
  if [[ "$PLATFORM" == "darwin" ]]; then
    echo "Lima VM:    $(limactl list --format '{{.Status}}' "$SBX_LIMA" 2>/dev/null || echo '(missing)')"
  fi
  echo "Network:    $(int_net_for "$pid")"
  echo -n "Proxy:      "
  if proxy_running_for "$pid"; then
    echo "running ($(proxy_ip_for "$pid"))"
  else
    echo "stopped"
  fi
}

usage() {
  cat <<EOF
sbx — egress-filtered sandbox for CLI tools

One container runtime, many projects in parallel.
  macOS: a single shared Lima VM ($SBX_LIMA) with \$HOME mounted.
  Linux: rootless containerd on the host, no VM.

Per project: its own --internal nerdctl network, proxy container
(with the project's allowlist), and /home/dev cache volume.

Commands:
  setup              Register the current dir as a project, start its proxy.
  reset              Tear down the current project's proxy+network+cache.
                     'reset --all' tears down every registered project.
  prune              Drop registry entries whose proxy container is gone.
  build              Rebuild the shared proxy + sandbox images.
  build-proxy        Rebuild proxy image and restart every running proxy.
  up                 Start the current project's proxy (no build).
  down               Stop the current project's proxy.
  status             State of the current project. 'status --all' lists all.
  logs               Tail the current project's proxy logs.
  run [opts] -- CMD  Run CMD in the sandbox of the project owning \$PWD.
  shell [opts]       Interactive fish shell in the sandbox.
  mounts             List host dirs the Lima VM is allowed to mount (macOS).
  add-mount <dir>    Allow Lima to mount <dir>. Restarts the shared VM,
                     which interrupts every running project (macOS only).

run options:
  --dir PATH         Cwd inside the project tree (default: \$PWD).
  --no-tty           Do not allocate a TTY (useful for piping).

Examples:
  cd ~/projA && bin/sbx setup
  cd ~/projB && bin/sbx setup        # parallel; same Lima VM on macOS
  bin/sbx run -- cargo build
  bin/sbx status --all
  bin/sbx reset                      # only this project
EOF
}

cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
case "$cmd" in
  setup)        cmd_setup        "$@" ;;
  reset)        cmd_reset        "$@" ;;
  prune)        cmd_prune        "$@" ;;
  build)        cmd_build        "$@" ;;
  build-proxy)  cmd_build_proxy  "$@" ;;
  up)           cmd_up           "$@" ;;
  down)         cmd_down         "$@" ;;
  status)       cmd_status       "$@" ;;
  logs)         cmd_logs         "$@" ;;
  run)          cmd_run          "$@" ;;
  shell)        cmd_shell        "$@" ;;
  mounts)       cmd_mounts       "$@" ;;
  add-mount)    cmd_add_mount    "$@" ;;
  ""|-h|--help) usage ;;
  *)            usage; exit 2 ;;
esac
